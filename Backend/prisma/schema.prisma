generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Comunidade Circuito
// ─────────────────────────────────────────────

enum PostStatus {
  OPEN
  RESOLVED
}

model Member {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  level     String?
  interests String[]
  role      String   @default("Membro")
  color     String   @default("mint")
  createdAt DateTime @default(now())

  sessions      Session[]
  posts         Post[]
  replies       Reply[]
  postVotes     PostVote[]
  replyVotes    ReplyVote[]
  bookmarks     Bookmark[]
  notifications Notification[]
}

// Sessão de demonstração: o token opaco só é guardado como hash SHA-256.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  createdAt DateTime @default(now())

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int

  @@index([memberId])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  icon        String   @default("box")
  description String?
  createdAt   DateTime @default(now())

  posts Post[]
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  label     String
  icon      String   @default("book")
  body      String   @db.Text
  createdAt DateTime @default(now())
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @db.Text
  image       String?    @db.Text
  status      PostStatus @default(OPEN)
  score       Int        @default(0)
  views       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author   Member @relation(fields: [authorId], references: [id])
  authorId Int

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  tags          PostTag[]
  replies       Reply[]
  votes         PostVote[]
  bookmarks     Bookmark[]
  terms         PostTerm[]
  notifications Notification[]

  @@index([categoryId, status, createdAt])
  @@index([authorId])
  @@index([score])
}

model Reply {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text
  accepted  Boolean  @default(false)
  score     Int      @default(0)
  createdAt DateTime @default(now())

  author   Member @relation(fields: [authorId], references: [id])
  authorId Int

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  votes ReplyVote[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  posts PostTag[]
}

model PostTag {
  postId Int
  tagId  Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
  @@index([tagId])
}

// value: +1 ou -1; repetir a mesma direção remove o voto.
model PostVote {
  memberId Int
  postId   Int
  value    Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([memberId, postId])
  @@index([postId])
}

model ReplyVote {
  memberId Int
  replyId  Int
  value    Int

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reply  Reply  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@id([memberId, replyId])
  @@index([replyId])
}

model Bookmark {
  memberId  Int
  postId    Int
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([memberId, postId])
  @@index([postId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId Int

  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int?

  @@index([memberId, read, createdAt])
}

// ─────────────────────────────────────────────
// Índice invertido para busca TF-IDF
// ─────────────────────────────────────────────

model Term {
  id    Int    @id @default(autoincrement())
  token String @unique

  posts PostTerm[]
}

model PostTerm {
  postId Int
  termId Int
  tf     Float // título×3, tags×2, solução aceita×2, descrição×1

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id])

  @@id([postId, termId])
  @@index([termId])
}
